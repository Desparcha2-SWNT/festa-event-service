# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
# En docker compose (festa-infra) estos valores ya los pone el compose; esto es para correr
# el servicio suelto, fuera de un contenedor.

PORT=8083
LOG_LEVEL=info

# Postgres con PostGIS (ver festa-infra/postgres/init)
DATABASE_URL=postgres://event_svc:change-me-event@localhost:5432/event_db

# RabbitMQ (contratos en festa-infra/contracts)
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672

# JWT que emite auth-service (RS256). El gateway ya valida el token; este servicio solo
# necesita la llave pública para leer el "sub" (userId) del token.
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
